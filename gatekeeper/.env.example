# Copy to .env and fill in. NEVER commit .env. NEVER paste these values into a chat or AI tool.

# --- Required ---------------------------------------------------------------
# One-time plaintext from Dashboard → My Agents → Rotate Secret.
AGENT_GAMES_HMAC_SECRET=
# How the secret string becomes the HMAC key: utf8 (string used as-is), hex or base64.
# The spec doesn't say. If preflight fails with a signature error, try hex.
AGENT_GAMES_HMAC_KEY_ENCODING=utf8

# --- Server -----------------------------------------------------------------
# Bind address. systemd + local Caddy: 127.0.0.1. (docker-compose sets 0.0.0.0 itself.)
HOST=
PORT=8080
# Register the FULL URL including this path, e.g. https://your-host.example.com/agent
AGENT_PATH=/agent
# systemd: /var/lib/gatekeeper. (docker-compose sets /app/data itself.)
DATA_DIR=./data

# --- Deployment (deploy/) ------------------------------------------------------
# Public hostname Caddy serves and gets a certificate for, e.g. yourname.duckdns.org
DOMAIN=
# DuckDNS subdomain only (yourname, not yourname.duckdns.org) and its account token.
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# --- Timing -----------------------------------------------------------------
# Accept issued_at up to this far in the past/future (clock skew + delivery delay).
MAX_CLOCK_SKEW_SECONDS=120
# Respond this long before the deadline. On timeout the agent fails closed (REJECT).
DEADLINE_SAFETY_MS=5000

# --- Reason codes -----------------------------------------------------------
# trap = codes from /events/proof-gatekeeper (VALID_CONDITION, PROOF_REUSED, ...)
# canonical = codes from /rules §6 (VALID_PROOF, PROOF_REPLAY, ...)
# Confirm in practice mode which set the scorer expects.
REASON_CODES=trap

# --- zkVerify via Kurier (optional; proofs are always generated locally) -----
# off = don't submit. background = after responding, submit the proof to Kurier and
# record the Finalized tx in DATA_DIR/evidence.jsonl for disputes.
KURIER_MODE=off
# testnet first. Mainnet must be chosen explicitly.
KURIER_NETWORK=testnet
KURIER_API_KEY=
# testnet: run `npm run register-vk` once and paste the printed vkHash here.
# mainnet: leave blank to use the platform-registered hash from /build.
KURIER_VK_HASH=
